<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The "parent" gives us sensible defaults + a curated set of library versions
         that are known to work together. This is why Spring Boot apps need so little config. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <!-- Identity of OUR project (group = company/team, artifact = app name) -->
    <groupId>com.vng.wallet</groupId>
    <artifactId>wallet-service</artifactId>
    <version>0.0.1</version>
    <name>wallet-service</name>
    <description>Learning microservice: a simple wallet/payment service</description>

    <properties>
        <!-- Compile to Java 21 bytecode (very stable + supported by every library),
             even though we RUN on Java 25. Avoids edge-case compatibility issues. -->
        <java.version>25</java.version>
        <!-- Docker Engine API version handed to docker-java for Testcontainers (SP5). -->
        <docker.api.version>1.43</docker.api.version>
    </properties>

    <dependencies>
        <!-- Web: gives us REST controllers + an embedded Tomcat server.
             A "microservice" is just an app that runs its own web server like this. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: lets us save/load Java objects to a database without writing raw SQL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation: lets us reject bad input (e.g. empty owner name) automatically. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2: an in-memory database. Starts instantly, no install needed.
             SP5: still used for fast slice tests (H2 supports CREATE/SET SCHEMA). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway (SP5, T7): versioned SQL migrations REPLACE hibernate ddl-auto.
             Migrations are the single source of truth for schema shape. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- flyway-mysql: MySQL-specific support module required by Flyway for MySQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MySQL driver (SP5, T10): prod target + Testcontainers integration realism. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers MySQL (SP5): prod-realistic schema-per-tenant integration tests. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MapStruct: sinh code mapping entity<->domain lúc COMPILE (không reflection). -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>

        <!-- Circuit breaker cho loi goi KYC (D7 - fail-closed co cache thoat hiem). -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Caffeine: cache in-memory cho trang thai KYC APPROVED (D6). Version do Boot quan. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- MockWebServer: gia kyc-service that qua HTTP trong adapter/integration test. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Kafka consumer cho event kyc.revoked (D5/D9) — bật bằng cờ wallet.events.kafka-enabled. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Test tools (JUnit etc.) — used when we write automated tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- EmbeddedKafka: test consumer không cần Docker. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Awaitility: chờ hành vi async (consumer evict cache). Version do Boot quản. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- This plugin lets us run the app with: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Surefire: forward a modern Docker API version to docker-java (Testcontainers).
                 docker-java's default (1.32) is rejected by modern engines (OrbStack/Docker >= API 1.40);
                 1.43 negotiates cleanly. Harmless on engines that already negotiate. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                        <!-- Stage4: inbound HMAC verification defaults ON in production. The pre-existing
                             functional test suite (230 tests) exercises wallet BUSINESS behavior and sends
                             unsigned MockMvc/TestRestTemplate requests; flip the filter OFF by default so
                             that behavior is preserved unchanged. Dedicated auth tests re-enable it with
                             @TestPropertySource(wallet.internal.auth-enabled=true) — Spring property source
                             precedence makes that win over this system property — and sign real requests. -->
                        <wallet.internal.auth-enabled>false</wallet.internal.auth-enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Annotation processor: MapStruct sinh WalletMapperImpl lúc compile. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
